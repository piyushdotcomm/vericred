# VeriCred environment variables
# Copy to .env.local and fill in values.

# Local Hardhat node (default, zero dependency)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Pinata IPFS (leave empty to use base64-in-link fallback)
PINATA_JWT=
PINATA_GATEWAY=

# Optional: Polygon Amoy (env-gated deploy target)
POLYGON_AMOY_RPC=
DEPLOYER_PRIVATE_KEY=
