# ---------------------------------------------------------------------------
# VeriCred environment variables
# Copy to .env.local (for Next.js) and fill in values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# ---- Chain / RPC ----------------------------------------------------------
# Polygon Amoy testnet (free) or local Hardhat (offline fallback).
# Use an Alchemy/QuickNode free RPC URL for production-like usage.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ---- WalletConnect (free) ------------------------------------------------
# Get a free project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Supabase (free Postgres) -------------------------------------------
# Server-side only (used by API routes). Do NOT expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Pinata IPFS (free tier, optional) -----------------------------------
# Leave empty to fall back to a deterministic local CID (works with zero setup).
PINATA_JWT=
PINATA_GATEWAY=

# ---- Polygon Amoy deploy (free testnet, optional) ------------------------
# Used only by Hardhat scripts. Get free test ETH from a Polygon Amoy faucet.
POLYGON_AMOY_RPC=
DEPLOYER_PRIVATE_KEY=
